{
  "name": "beaksight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "bin": {
    "beaksight": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('schemas', 'dist/schemas', { recursive: true });\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/component",
    "test:integration": "vitest run tests/integration",
    "verify": "npm run typecheck && npm run test && npm run build",
    "build:ui": "vite build apps/local-ui",
    "typecheck:ui": "tsc -p apps/local-ui/tsconfig.json --noEmit && tsc -p apps/local-ui/tsconfig.config.json --noEmit",
    "test:ui": "vitest run --config apps/local-ui/vitest.config.ts",
    "verify:ui": "npm run build:ui && npm run typecheck:ui && npm run test:ui",
    "verify:all": "npm run verify && npm run verify:ui",
    "ui:dev": "vite dev apps/local-ui",
    "setup:local": "npm run build && node dist/control/setup-local.js",
    "ui": "npm run build && npm run build:ui && node apps/local-ui/launcher/serve.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "playwright": "1.62.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-vitals": "6.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.4",
    "vitest": "4.1.11"
  }
}
