{
  "name": "beaksight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "beaksight": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('schemas', 'dist/schemas', { recursive: true });\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/component",
    "test:integration": "vitest run tests/integration",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "playwright": "1.62.1",
    "web-vitals": "6.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
