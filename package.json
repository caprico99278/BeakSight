{
  "name": "beaksight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "bin": {
    "beaksight": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('schemas', 'dist/schemas', { recursive: true });\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/component",
    "test:fast": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:heavy": "vitest run --project heavy",
    "test:safety": "node tests/run-suite.mjs safety",
    "test:full": "node tests/run-suite.mjs full",
    "verify": "npm run typecheck && npm run build && npm run build:ui && npm run typecheck:ui && npm run test:full",
    "build:ui": "vite build apps/local-ui",
    "typecheck:ui": "tsc -p apps/local-ui/tsconfig.json --noEmit && tsc -p apps/local-ui/tsconfig.config.json --noEmit",
    "test:ui": "vitest run --config apps/local-ui/vitest.config.ts",
    "verify:ui": "npm run build:ui && npm run typecheck:ui && npm run test:ui",
    "verify:all": "npm run verify",
    "ui:dev": "vite dev apps/local-ui",
    "setup:local": "npm run build && node dist/control/setup-local.js",
    "ui": "npm run build && npm run build:ui && node apps/local-ui/launcher/serve.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
