{
  "$id": "urn:beaksight:schema:action-evidence:1.0",
  "description": "The evidence of one write job for the write report (action-evidence.json in the Run directory; Task 32 design 4.1; T32c), written by the worker for every run it finishes (BLOCKED included). It is built from the same facts as action-run.json: the check before sending (the candidate digest match and the block reason), the submission (the submitted values, synthetic test data in plain text, and the action path), the response, the record id, the before and after values of an UPDATE, the whole evidence of the READ verification (or a mark that it was not executed), the counts of the request guard, the ActionResult and its reason. A run that was not sent has no submitted value, no response, no record id and no executed READ. Values entered by people (the prior value of a changed field, the value read by the READ verification) are kept and marked by containsHumanEnteredValues. The value lists and limits are those of action-run, read-evidence, run and control/scenario, referenced and not copied; the contract is src/control/actions/action-contracts.ts. No property holds a credential, a cookie, a CSRF token, a hidden, readonly or kept value, a lock version or an authenticated state. T40c (Task 40 design 3.4): the version 1.1 adds the transport and the API summary (the same values as action-run.json; null for FORM); the action path of an API write is the path of the API. The readers accept 1.1 only (LG-4: the previous version 1.0 is no longer read); the writer writes 1.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "runId",
    "profileId",
    "scenarioId",
    "scenarioRevision",
    "kind",
    "containsHumanEnteredValues",
    "precheck",
    "submission",
    "response",
    "recordId",
    "update",
    "readVerification",
    "guard",
    "result",
    "reason",
    "startedAt",
    "finishedAt",
    "transport",
    "api"
  ],
  "properties": {
    "schemaVersion": { "enum": ["action-evidence-schema/1.1"] },
    "jobId": { "$ref": "urn:beaksight:schema:action-run:1.0#/$defs/id" },
    "runId": { "$ref": "urn:beaksight:schema:run:1.0#/properties/runId" },
    "profileId": { "$ref": "urn:beaksight:schema:action-run:1.0#/properties/profileId" },
    "scenarioId": { "$ref": "urn:beaksight:schema:action-run:1.0#/$defs/id" },
    "scenarioRevision": { "$ref": "urn:beaksight:schema:action-run:1.0#/$defs/revision" },
    "kind": { "$ref": "urn:beaksight:schema:control:scenario:1#/properties/kind" },
    "containsHumanEnteredValues": { "type": "boolean" },
    "precheck": { "$ref": "#/$defs/precheck" },
    "submission": { "$ref": "#/$defs/submission" },
    "response": { "anyOf": [{ "$ref": "#/$defs/response" }, { "type": "null" }] },
    "recordId": { "$ref": "urn:beaksight:schema:action-run:1.0#/properties/recordId" },
    "update": { "anyOf": [{ "$ref": "urn:beaksight:schema:action-run:1.0#/properties/update" }, { "type": "null" }] },
    "readVerification": {
      "oneOf": [{ "$ref": "urn:beaksight:schema:read-evidence:1.0#/$defs/executed" }, { "$ref": "#/$defs/readVerificationNotExecuted" }]
    },
    "guard": { "anyOf": [{ "$ref": "#/$defs/guardSummary" }, { "type": "null" }] },
    "result": { "$ref": "urn:beaksight:schema:action-run:1.0#/properties/result" },
    "reason": { "$ref": "urn:beaksight:schema:action-run:1.0#/properties/reason" },
    "startedAt": { "$ref": "urn:beaksight:schema:action-run:1.0#/$defs/compactUtcTimestamp" },
    "finishedAt": { "$ref": "urn:beaksight:schema:action-run:1.0#/$defs/compactUtcTimestamp" },
    "transport": { "$ref": "urn:beaksight:schema:action-run:1.0#/properties/transport" },
    "api": { "$ref": "urn:beaksight:schema:action-run:1.0#/properties/api" }
  },
  "allOf": [
    {
      "description": "T40c: an API evidence has the API summary (its page key values are null when not sent); a FORM evidence has none.",
      "if": { "properties": { "transport": { "const": "API" } } },
      "then": { "properties": { "api": { "type": "object" } } },
      "else": { "properties": { "api": { "type": "null" } } }
    },
    {
      "description": "T40c: a run that was not sent has no value of the keys decided by the page.",
      "if": { "properties": { "submission": { "type": "object", "properties": { "state": { "const": "NOT_SENT" } } } } },
      "then": {
        "properties": { "api": { "anyOf": [{ "type": "null" }, { "type": "object", "properties": { "pageKeyValues": { "type": "null" } } }] } }
      }
    },
    {
      "description": "A run that was not sent is BLOCKED with a block reason, and has no submitted value, no action path, no response, no record id and no executed READ. A sent run has no block reason, a matched candidate, an action path and a response item, and is not BLOCKED.",
      "if": { "properties": { "submission": { "type": "object", "properties": { "state": { "const": "NOT_SENT" } } } } },
      "then": {
        "properties": {
          "precheck": { "type": "object", "properties": { "blockReason": { "type": "string" } } },
          "submission": {
            "type": "object",
            "properties": {
              "submittedValues": { "type": "object", "maxProperties": 0 },
              "actionPath": { "type": "null" },
              "submittedAt": { "type": "null" }
            }
          },
          "response": { "type": "null" },
          "recordId": { "type": "null" },
          "readVerification": { "type": "object", "properties": { "state": { "const": "NOT_EXECUTED" } } },
          "result": { "const": "BLOCKED" }
        }
      },
      "else": {
        "properties": {
          "precheck": { "type": "object", "properties": { "candidateDigestMatched": { "const": true }, "blockReason": { "type": "null" }, "inputFailure": false } },
          "submission": { "type": "object", "properties": { "actionPath": { "type": "string" } } },
          "response": { "type": "object" },
          "result": { "not": { "const": "BLOCKED" } }
        }
      }
    },
    {
      "description": "Only an UPDATE has the update block.",
      "if": { "properties": { "kind": { "const": "CREATE" } } },
      "then": { "properties": { "update": { "type": "null" } } },
      "else": { "properties": { "update": { "type": "object" } } }
    },
    {
      "description": "A prior value of a changed field is a value entered by people: the mark is true.",
      "if": {
        "required": ["update"],
        "properties": {
          "update": {
            "type": "object",
            "required": ["updateEvidence"],
            "properties": {
              "updateEvidence": {
                "type": "object",
                "required": ["fields"],
                "properties": { "fields": { "type": "array", "contains": { "type": "object", "properties": { "role": { "const": "CHANGED" } } } } }
              }
            }
          }
        }
      },
      "then": { "properties": { "containsHumanEnteredValues": { "const": true } } }
    },
    {
      "description": "A value read by the READ verification is a value entered by people: the mark is true.",
      "if": {
        "required": ["readVerification"],
        "properties": {
          "readVerification": {
            "type": "object",
            "required": ["expectations"],
            "properties": {
              "expectations": {
                "type": "array",
                "contains": { "type": "object", "required": ["observedValue"], "properties": { "observedValue": { "type": "string" } } }
              }
            }
          }
        }
      },
      "then": { "properties": { "containsHumanEnteredValues": { "const": true } } }
    }
  ],
  "$defs": {
    "precheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateDigestMatched", "blockReason"],
      "properties": {
        "candidateDigestMatched": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
        "blockReason": { "$ref": "urn:beaksight:schema:action-run:1.0#/properties/blockReason" },
        "candidateMismatch": { "$ref": "#/$defs/candidateMismatch" },
        "inputFailure": { "$ref": "#/$defs/inputFailure" }
      }
    },
    "inputFailure": {
      "description": "OP-O (O1): the stage, the reason and the field facts of a failed inspection, input or press in the write stage (WRITE_INPUT_FAILURE_* in src/control/actions/action-contracts.ts). Never a value or the length of a value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "reason", "fieldPosition", "fieldType", "fieldAttributes", "valueChange"],
      "properties": {
        "stage": { "enum": ["INSPECT", "FILL", "SUBMIT"] },
        "reason": {
          "enum": [
            "SPEC_INVALID", "PAGE_UNREADABLE", "FIELD_NOT_FOUND", "FIELD_AMBIGUOUS", "FIELD_TYPE_NOT_SUPPORTED", "FIELD_NOT_VISIBLE", "FIELD_NOT_EDITABLE",
            "SUBMITTER_NOT_FOUND", "SUBMITTER_AMBIGUOUS", "SUBMITTER_INSIDE_LINK", "ELEMENT_CHANGED", "INPUT_FAILED", "VALUE_CHANGED", "SUBMIT_FAILED",
            "FORM_UNREADABLE", "FORM_NOT_FOUND", "FORM_AMBIGUOUS", "FIELD_OWNED_BY_OTHER_FORM", "FORM_FIELDS_CHANGED", "FIELD_TYPE_MISMATCH", "METHOD_NOT_POST",
            "ACTION_NOT_ALLOWED", "ENCTYPE_NOT_ALLOWED", "ENCTYPE_MISMATCH", "FORM_TARGET_NOT_SELF", "ACCEPT_CHARSET_NOT_UTF8", "FORM_CHANGED",
            "VALUE_NOT_SUPPORTED", "VALUE_NOT_APPLIED", "PRIOR_VALUE_CHANGED", "CHECKBOX_PAIR_NOT_ADJACENT", "SECRET_LIKE_STATE_FIELD",
            "SECRET_LIKE_PASSTHROUGH_FIELD"
          ]
        },
        "fieldPosition": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 1000 }, { "type": "null" }] },
        "fieldType": { "anyOf": [{ "$ref": "urn:beaksight:schema:control:candidate:1#/$defs/field/properties/type" }, { "type": "null" }] },
        "fieldAttributes": {
          "anyOf": [
            { "type": "array", "uniqueItems": true, "maxItems": 7, "items": { "enum": ["readonly", "disabled", "maxlength", "pattern", "min", "max", "step"] } },
            { "type": "null" }
          ]
        },
        "valueChange": { "anyOf": [{ "enum": ["EMPTIED", "SURROUNDING_WHITESPACE", "DIGIT_GROUPING", "NUMBER_FORMAT", "OTHER"] }, { "type": "null" }] }
      }
    },
    "candidateMismatch": {
      "description": "OP-L (L1): where the approved candidate did not match the current page (PRECHECK_CANDIDATE_MISMATCH_REASONS). Never a value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "pageCandidateCount", "sameIdentityCount", "fieldPosition"],
      "properties": {
        "reason": { "enum": ["IDENTITY_NOT_FOUND", "IDENTITY_AMBIGUOUS", "RULE_DIGEST_CHANGED", "RECORD_ID_NOT_IN_PATH", "SPEC_INVALID", "PAGE_UNREADABLE", "FIELD_NOT_FOUND", "FIELD_AMBIGUOUS", "FIELD_TYPE_NOT_SUPPORTED", "FIELD_NOT_VISIBLE", "FIELD_NOT_EDITABLE", "SUBMITTER_NOT_FOUND", "SUBMITTER_AMBIGUOUS", "SUBMITTER_INSIDE_LINK"] },
        "pageCandidateCount": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 100000 }, { "type": "null" }] },
        "sameIdentityCount": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 100000 }, { "type": "null" }] },
        "fieldPosition": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 1000 }, { "type": "null" }] }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "submittedValues", "actionPath", "submittedAt"],
      "properties": {
        "state": { "$ref": "urn:beaksight:schema:action-run:1.0#/properties/submission" },
        "submittedValues": { "$ref": "urn:beaksight:schema:action-run:1.0#/properties/submittedValues" },
        "actionPath": { "anyOf": [{ "$ref": "urn:beaksight:schema:control:scenario:1#/$defs/request/properties/path" }, { "type": "null" }] },
        "submittedAt": { "anyOf": [{ "$ref": "urn:beaksight:schema:action-run:1.0#/$defs/compactUtcTimestamp" }, { "type": "null" }] }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["httpStatus", "judgement", "judgedAt"],
      "properties": {
        "httpStatus": { "$ref": "urn:beaksight:schema:action-run:1.0#/properties/httpStatus" },
        "judgement": { "$ref": "urn:beaksight:schema:action-run:1.0#/properties/responseJudgement" },
        "judgedAt": { "anyOf": [{ "$ref": "urn:beaksight:schema:action-run:1.0#/$defs/compactUtcTimestamp" }, { "type": "null" }] }
      }
    },
    "readVerificationNotExecuted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readCheckId", "readCheckRevision", "state"],
      "properties": {
        "readCheckId": { "$ref": "urn:beaksight:schema:action-run:1.0#/$defs/id" },
        "readCheckRevision": { "$ref": "urn:beaksight:schema:action-run:1.0#/$defs/revision" },
        "state": { "const": "NOT_EXECUTED" }
      }
    },
    "guardSummary": {
      "description": "The counts and marks of the write stage of the request guard (the names of WriteStageMonitorSnapshot in src/safety/passive-request-guard.ts). No URL, value or body.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockedByReason",
        "blockedByOtherRulesInWindow",
        "submissionWindowOpen",
        "blockedByPayloadReason",
        "documentCharsetRead",
        "responseDeliveryCanceled"
      ],
      "properties": {
        "blockedByReason": {
          "type": "object",
          "propertyNames": { "enum": ["OUTSIDE_ALLOWED_ORIGINS", "SUBMISSION_WINDOW", "SUBMISSION_WINDOW_BROWSER_FAVICON"] },
          "additionalProperties": { "$ref": "urn:beaksight:schema:read-evidence:1.0#/$defs/count" }
        },
        "blockedByOtherRulesInWindow": { "$ref": "urn:beaksight:schema:read-evidence:1.0#/$defs/count" },
        "submissionWindowOpen": { "type": "boolean" },
        "blockedByPayloadReason": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "EXPECTATION_INVALID",
              "NOT_POST",
              "NOT_MAIN_FRAME_NAVIGATION",
              "QUERY_OR_FRAGMENT_PRESENT",
              "ENDPOINT_MISMATCH",
              "DOCUMENT_CHARSET_UNKNOWN",
              "DOCUMENT_CHARSET_NOT_UTF8",
              "ENCTYPE_NOT_ALLOWED",
              "ENCTYPE_MISMATCH",
              "BODY_UNAVAILABLE",
              "BODY_INCOMPLETE",
              "BODY_TOO_LARGE",
              "BODY_MALFORMED",
              "UNKNOWN_FIELD",
              "DUPLICATE_FIELD",
              "SUBMITTED_FIELD_MISSING",
              "VALUE_MISMATCH",
              "FILE_NOT_EMPTY",
              "METHOD_OVERRIDE_MISMATCH",
              "UNEXPECTED_FIELD_PRESENT",
              "PASSTHROUGH_VALUE_MISMATCH",
              "CHECKBOX_PAIR_MISMATCH",
              "METHOD_MISMATCH",
              "METHOD_OVERRIDE_PRESENT",
              "QUERY_MISMATCH",
              "FILTER_MISMATCH",
              "HEADER_NOT_ALLOWED",
              "CONTENT_TYPE_MISMATCH",
              "PREFER_MISMATCH",
              "BODY_NOT_OBJECT",
              "BODY_DUPLICATE_KEY",
              "BODY_VALUE_NOT_SCALAR",
              "BODY_KEY_MISSING",
              "BODY_KEY_UNEXPECTED",
              "BODY_VALUE_TYPE_MISMATCH",
              "BODY_VALUE_MISMATCH",
              "BODY_STATE_KEY_UNEXPECTED"
            ]
          },
          "additionalProperties": { "$ref": "urn:beaksight:schema:read-evidence:1.0#/$defs/count" }
        },
        "documentCharsetRead": { "type": "boolean" },
        "responseDeliveryCanceled": { "type": "boolean" },
        "unexpectedRequests": { "$ref": "#/$defs/unexpectedRequests" },
        "unexpectedRequestsUnlisted": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "passedRequests": {
          "description": "OP-N (optional): the requests that the site sent by itself and the request guard passed in the write stage under the audit send policy PASS_EXCEPT_DELETE (same shape as unexpectedRequests; the reason is AUDIT_SEND_PASSED). Not counted as writes. No origin name, query, body or value.",
          "$ref": "#/$defs/unexpectedRequests"
        },
        "passedRequestsUnlisted": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "unexpectedRequests": {
      "description": "OP-M (optional): the requests other than the approved send that the request guard blocked in the write stage (src/safety/write-stage-unexpected-requests.ts). No origin name, query, body or value.",
      "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "destination", "pathShape", "resourceType", "timing", "reason", "markerInBody", "bodyKind", "count"],
            "properties": {
              "method": { "type": "string", "pattern": "^(?:[A-Z]+|\\[REDACTED\\])$", "maxLength": 32 },
              "destination": { "enum": ["TEST_ORIGIN", "APPROVED_SERVICE_ORIGIN", "OUTSIDE_ALLOWED_ORIGINS"] },
              "pathShape": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "resourceType": { "type": "string", "pattern": "^[a-z]+$", "maxLength": 64 },
              "timing": { "enum": ["BEFORE_FILL", "AFTER_FILL", "AFTER_PRESS"] },
              "reason": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 64 },
              "markerInBody": { "type": "boolean" },
              "bodyKind": { "enum": ["NONE", "UNREADABLE", "NOT_JSON", "OBJECT", "ARRAY", "SCALAR"] },
              "count": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
            }
          }
    }
  }
}
