{
  "$id": "urn:beaksight:schema:control:auth-setup:1",
  "description": "Auth setup document version 1, bound to a TEST_AUTH_PASSIVE profile when it was saved (Task 25 design 4.1). Stored version 1 documents are read as version 2 (auth-setup-v2.schema.json); the modes that accept an auth setup are decided by src/control/execution-policy.ts. Shape and limits only; the rules are in src/control/auth/auth-setup-policy.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "profileRevision",
    "loginStartUrl",
    "loginPostEndpoints",
    "successCondition",
    "sessionLostCondition",
    "excludedPaths",
    "auditPathPrefixes",
    "maxLoginAttempts",
    "allowedIdpOrigins"
  ],
  "properties": {
    "schemaVersion": { "const": "beaksight-auth-setup/1" },
    "profileId": { "$ref": "urn:beaksight:schema:control:profile:1#/properties/profileId" },
    "profileRevision": { "type": "integer", "minimum": 1 },
    "loginStartUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "loginPostEndpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin", "path"],
        "properties": {
          "origin": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "path": { "type": "string", "maxLength": 2048 }
        }
      }
    },
    "successCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathPrefix", "selector"],
      "properties": {
        "pathPrefix": { "type": "string", "maxLength": 2048 },
        "selector": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "sessionLostCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathPrefix"],
      "properties": {
        "pathPrefix": { "type": ["string", "null"], "maxLength": 2048 }
      }
    },
    "excludedPaths": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 2048 }
    },
    "auditPathPrefixes": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 2048 }
    },
    "maxLoginAttempts": { "type": "integer", "minimum": 1, "maximum": 3 },
    "allowedIdpOrigins": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 2048 }
    }
  }
}
