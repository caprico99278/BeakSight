{
  "$id": "urn:beaksight:schema:control:candidate:1",
  "description": "One candidate of the side-effect-free discovery (an item of discovery.json; Task 27 design 4.1). The value lists and limits are owned by src/discovery/candidate-contracts.ts. No property holds an input value, a token, an option label or the text of a submit button (only the classification words that the text hit; T27R-fix-1, DEF-086).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "page",
    "kind",
    "formMethod",
    "methodOverride",
    "action",
    "enctype",
    "target",
    "fields",
    "submitterWords",
    "jsBinding",
    "incompleteReasons",
    "classification",
    "reasonCode",
    "hasStateField",
    "identityDigest",
    "ruleDigest"
  ],
  "properties": {
    "page": { "$ref": "#/$defs/location" },
    "kind": { "enum": ["FORM", "BUTTON"] },
    "formMethod": { "anyOf": [{ "enum": ["GET", "POST", "DIALOG"] }, { "type": "null" }] },
    "methodOverride": { "anyOf": [{ "enum": ["PUT", "PATCH", "DELETE"] }, { "type": "null" }] },
    "action": { "anyOf": [{ "$ref": "#/$defs/action" }, { "type": "null" }] },
    "enctype": {
      "anyOf": [
        { "enum": ["application/x-www-form-urlencoded", "multipart/form-data", "text/plain"] },
        { "type": "null" }
      ]
    },
    "target": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
    "submitterWords": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 72,
      "items": {
        "enum": [
          "logout",
          "signout",
          "sign-out",
          "log-out",
          "delete",
          "remove",
          "destroy",
          "cancel",
          "archive",
          "deactivate",
          "disable",
          "revoke",
          "purge",
          "withdraw",
          "unsubscribe",
          "terminate",
          "suspend",
          "discard",
          "erase",
          "wipe",
          "truncate",
          "bulk",
          "batch",
          "reset",
          "削除",
          "取り消",
          "取消",
          "一括",
          "無効",
          "解約",
          "退会",
          "アーカイブ",
          "廃止",
          "停止",
          "キャンセル",
          "破棄",
          "消去",
          "抹消",
          "中止",
          "ログアウト",
          "signoff",
          "sign-off",
          "ログオフ",
          "サインアウト",
          "search",
          "filter",
          "find",
          "query",
          "lookup",
          "検索",
          "絞り込",
          "絞込",
          "探す",
          "update",
          "save",
          "edit",
          "change",
          "modify",
          "更新",
          "保存",
          "編集",
          "変更",
          "修正",
          "create",
          "add",
          "new",
          "register",
          "insert",
          "登録",
          "追加",
          "作成",
          "新規"
        ]
      }
    },
    "jsBinding": { "$ref": "#/$defs/jsBinding" },
    "incompleteReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "INCOMPLETE_SETTLE_TIMEOUT",
          "INCOMPLETE_FRAME_OR_CLOSED_SHADOW",
          "INCOMPLETE_FREEZE_UNAVAILABLE",
          "INCOMPLETE_READ_FAILED",
          "INCOMPLETE_LIMIT_REACHED",
          "INCOMPLETE_PAGE_NAVIGATION_LIMIT",
          "INCOMPLETE_PAGE_SUBRESOURCE_LIMIT",
          "NOTIFICATION_DISMISSAL_NAVIGATION_BLOCKED",
          "SERVICE_READ_REFUSED",
          "STAGE_UNRESPONSIVE",
          "STAGE_NEVER_QUIET"
        ]
      }
    },
    "classification": {
      "enum": [
        "READ",
        "CREATE",
        "UPDATE",
        "NOT_EXECUTABLE",
        "NEEDS_BINDING",
        "UNSUPPORTED_READ_TRANSPORT",
        "BLOCKED_EXTERNAL",
        "DISPLAY_ONLY"
      ]
    },
    "reasonCode": {
      "enum": [
        "ACTION_OUTSIDE_ALLOWED_ORIGINS",
        "DESTRUCTIVE",
        "READ_GET_FORM",
        "GET_WITH_PASSWORD_FIELD",
        "GET_WITH_MULTIPART",
        "POST_SEARCH",
        "GRAPHQL_ENDPOINT",
        "JS_BOUND",
        "JS_DELEGATED",
        "NO_KNOWN_ACTION",
        "DIALOG_METHOD",
        "METHOD_OVERRIDE_UNRECOGNIZED",
        "UPDATE_METHOD",
        "UPDATE_WORD",
        "CREATE_WORD",
        "UNCLASSIFIED",
        "DUPLICATE_IDENTITY_CONFLICT"
      ]
    },
    "hasStateField": { "type": "boolean" },
    "identityDigest": { "$ref": "#/$defs/digest" },
    "ruleDigest": { "$ref": "#/$defs/digest" },
    "submissionProbe": {
      "description": "Optional (T37c; Task 37 design 3.4): the result of the submission probe (pressed in the frozen Context; nothing is sent). Only the candidates that were probe targets have it. Not part of the identity or the rule digest. The contract is src/discovery/submission-probe-contracts.ts.",
      "$ref": "#/$defs/submissionProbe"
    },
    "rowOpener": {
      "description": "Optional (LU-11; list row update design 5.4-4, D5): the opener (a named row editor button) of the list row that holds this form, or of the table row just before the hidden row that holds it. The same shape as the opener of a submission probe. Only when exactly one opener is in the row. Never a value or the content of a row. Not part of the identity or the rule digest. Absent in the candidates written before LU-11.",
      "$ref": "#/$defs/submissionProbe/properties/opener"
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "kind": { "const": "FORM" } }, "required": ["kind"] },
      "then": {
        "type": "object",
        "properties": {
          "formMethod": { "type": "string" },
          "action": { "type": "object" },
          "enctype": { "type": "string" }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "kind": { "const": "BUTTON" } }, "required": ["kind"] },
      "then": {
        "type": "object",
        "properties": {
          "formMethod": { "type": "null" },
          "methodOverride": { "type": "null" },
          "action": { "type": "null" },
          "enctype": { "type": "null" },
          "target": { "type": "null" },
          "fields": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "path"],
      "properties": {
        "origin": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "path", "queryNames"],
      "properties": {
        "origin": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "queryNames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "min", "max", "step", "minlength", "maxlength", "autocomplete"],
      "properties": {
        "pattern": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "min": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "max": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "step": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "minlength": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "maxlength": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "autocomplete": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tag",
        "type",
        "required",
        "readonly",
        "disabled",
        "hidden",
        "constraints",
        "options",
        "omittedOptionCount",
        "hasValue"
      ],
      "properties": {
        "name": { "type": "string" },
        "tag": { "enum": ["input", "select", "textarea"] },
        "type": {
          "enum": [
            "text",
            "search",
            "email",
            "url",
            "tel",
            "password",
            "number",
            "range",
            "date",
            "month",
            "week",
            "time",
            "datetime-local",
            "color",
            "checkbox",
            "radio",
            "file",
            "hidden",
            "select-one",
            "select-multiple",
            "textarea"
          ]
        },
        "required": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "constraints": { "$ref": "#/$defs/constraints" },
        "options": {
          "anyOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "null" }
          ]
        },
        "omittedOptionCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "hasValue": { "type": "boolean" },
        "destructiveOptionIndexes": {
          "description": "REV-RCA I-3: the positions in options of the choices whose value or shown text has a delete word (optional; the shown text is not kept).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    "listenerKinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "click",
          "dblclick",
          "auxclick",
          "submit",
          "formdata",
          "keydown",
          "keyup",
          "keypress",
          "pointerdown",
          "pointerup",
          "mousedown",
          "mouseup",
          "touchstart",
          "touchend",
          "change",
          "input"
        ]
      }
    },
    "jsBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "submitter", "ancestor", "document", "window", "inlineHandler"],
      "properties": {
        "form": { "$ref": "#/$defs/listenerKinds" },
        "submitter": { "$ref": "#/$defs/listenerKinds" },
        "ancestor": { "$ref": "#/$defs/listenerKinds" },
        "document": { "$ref": "#/$defs/listenerKinds" },
        "window": { "$ref": "#/$defs/listenerKinds" },
        "inlineHandler": { "type": "boolean" }
      }
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "submissionProbe": {
      "description": "T37c: the result of the submission probe. No value: never a marker, a body value, a query value or a header value. The result, the reason and the shape follow the T37b classification (src/discovery/api-shape-classification.ts); NOT_OBSERVED has its own reasons.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "reason",
        "shape",
        "shapeDigest",
        "nonReadRequestCount",
        "readRequestCount",
        "unrecordedShapeCount",
        "filledFieldCount",
        "skippedFieldCount"
      ],
      "properties": {
        "result": { "enum": ["API_CREATE", "API_UPDATE", "NOT_EXECUTABLE", "NO_REQUEST", "NOT_OBSERVED"] },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "DELETE_METHOD",
                "PUT_METHOD",
                "METHOD_OVERRIDE",
                "UNAPPROVED_ORIGIN",
                "PROCEDURE_CALL_PATH",
                "UPSERT",
                "ARRAY_BODY",
                "NON_JSON_BODY",
                "MULTIPLE_REQUESTS",
                "SOFT_DELETE_KEY",
                "SHAPE_TRUNCATED",
                "FILTER_MISSING",
                "FILTER_MULTIPLE",
                "FILTER_NOT_PAGE_VALUE",
                "CREATE_PATH_HAS_ID",
                "UNRECOGNIZED",
                "EXTERNAL_SCHEME",
                "OPENER_SIDE_REQUEST",
                "AI_GENERATION_REQUEST",
                "PAGE_CHANGED",
                "PRESS_LIMIT_REACHED",
                "TARGET_NOT_FOUND",
                "PRESS_FAILED",
                "CONTEXT_CLOSED_BY_GUARD",
                "SAME_IDENTITY_PRESSED",
                "SAME_WORDS_NO_REQUEST",
                "DISABLED_SUBMITTER",
                "SHARED_LAYOUT_PRESSED",
                "DISABLED_FILL_LIMIT_REACHED",
                "SAME_STATE_PRESSED",
                "STAGE_UNRESPONSIVE",
                "STAGE_NEVER_QUIET",
                "COVERED_BY_OTHER",
                "DESTRUCTIVE_ACTION_SKIPPED",
                "TARGET_VANISHED",
                "NOT_REACHED",
                "TARGET_NOT_STABLE",
                "TARGET_NOT_VISIBLE",
                "STATE_NOT_REBUILT",
                "AI_ACTION_SKIPPED",
                "SAME_SHAPE_NO_CHANGE"
              ]
            },
            { "type": "null" }
          ]
        },
        "shape": { "anyOf": [{ "$ref": "#/$defs/apiRequestShape" }, { "type": "null" }] },
        "shapeDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "nonReadRequestCount": { "$ref": "#/$defs/count" },
        "readRequestCount": { "$ref": "#/$defs/count" },
        "unrecordedShapeCount": { "$ref": "#/$defs/count" },
        "filledFieldCount": { "$ref": "#/$defs/count" },
        "skippedFieldCount": { "$ref": "#/$defs/count" },
        "inputFields": {
          "description": "Optional (T38a; Task 38 design 3.1): the fields the probe filled or selected before the press (for a BUTTON candidate, the fields outside the forms). The name attribute, the unique CSS on the screen (T43c builder, a Playwright-parsable shape) and the field type; the marker is the number of the marker of the press (0-based for each press; null for a selected field). Never a value. Absent in the probes written before T38a.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "selector", "type", "marker"],
            "properties": {
              "name": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
              "selector": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
              "type": { "$ref": "#/$defs/field/properties/type" },
              "marker": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
            }
          }
        },
        "opener": {
          "description": "Optional (LU-4; list row update design 5.1-2): the opener (a row editor button) pressed before the probe pressed this target after the re-read. The identity digest of the opener candidate, whether the opener has a name (the visible text, aria-label or title) and its opener words. Never a value or the content of a row. Absent in the probes not pressed after an opener and in the probes written before LU-4.",
          "type": "object",
          "additionalProperties": false,
          "required": ["identityDigest", "hasName", "openerWords"],
          "properties": {
            "identityDigest": { "$ref": "#/$defs/digest" },
            "hasName": { "type": "boolean" },
            "openerWords": { "type": "array", "uniqueItems": true, "maxItems": 3, "items": { "enum": ["編集", "修正", "edit"] } }
          }
        },
        "stage": {
          "description": "Optional (COV-1; coverage by state design 3.3, DEF-238 design 3.1-2): the stage (the order in which the state of the screen, its structure key, first appeared; 2 or more) of a probe pressed or seen after a press changed the screen, and the presses on the same screen before this press (the stage, the candidate identity digest and the order among the candidates of the same digest). Never a value. Absent on the first stage and in the probes written before COV-1.",
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "priorPresses"],
          "properties": {
            "number": { "type": "integer", "minimum": 2, "maximum": 9007199254740991 },
            "priorPresses": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stage", "identityDigest", "ordinal"],
                "properties": {
                  "stage": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                  "identityDigest": { "$ref": "#/$defs/digest" },
                  "ordinal": { "$ref": "#/$defs/count" }
                }
              }
            }
          }
        },
        "chainEnd": {
          "description": "Optional (COV-2c; coverage by state design, SREV-COV I-1): the press only added parts of a make already seen on the screen (no new structure signature), so the probe did not take the screen after the press as a new state and closed the chain of presses there (NO_NEW_STRUCTURE). Never a value. Absent otherwise and in the probes written before COV-2c.",
          "enum": ["NO_NEW_STRUCTURE"]
        },
        "aiAction": {
          "description": "Optional (AIW 4): the press made an AI request (a destination path with an AI word, or a streaming answer), so the probe keeps the candidate as an AI action: it is not pressed again, it is not a create or update candidate, and the search check leaves out the triggers that press it. Absent otherwise and in the probes written before AIW.",
          "const": true
        }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "result": { "const": "NOT_EXECUTABLE" } }, "required": ["result"] },
          "then": {
            "type": "object",
            "properties": {
              "reason": {
                "enum": [
                  "DELETE_METHOD",
                  "PUT_METHOD",
                  "METHOD_OVERRIDE",
                  "UNAPPROVED_ORIGIN",
                  "PROCEDURE_CALL_PATH",
                  "UPSERT",
                  "ARRAY_BODY",
                  "NON_JSON_BODY",
                  "MULTIPLE_REQUESTS",
                  "SOFT_DELETE_KEY",
                  "SHAPE_TRUNCATED",
                  "FILTER_MISSING",
                  "FILTER_MULTIPLE",
                  "FILTER_NOT_PAGE_VALUE",
                  "CREATE_PATH_HAS_ID",
                  "UNRECOGNIZED",
                  "EXTERNAL_SCHEME",
                  "OPENER_SIDE_REQUEST",
                  "AI_GENERATION_REQUEST"
                ]
              }
            }
          }
        },
        {
          "if": { "type": "object", "properties": { "result": { "const": "NOT_OBSERVED" } }, "required": ["result"] },
          "then": {
            "type": "object",
            "properties": {
              "reason": { "enum": ["PAGE_CHANGED", "PRESS_LIMIT_REACHED", "TARGET_NOT_FOUND", "PRESS_FAILED", "CONTEXT_CLOSED_BY_GUARD", "SAME_IDENTITY_PRESSED", "SAME_WORDS_NO_REQUEST", "DISABLED_SUBMITTER", "SHARED_LAYOUT_PRESSED", "DISABLED_FILL_LIMIT_REACHED", "SAME_STATE_PRESSED", "STAGE_UNRESPONSIVE", "STAGE_NEVER_QUIET", "COVERED_BY_OTHER", "DESTRUCTIVE_ACTION_SKIPPED", "TARGET_VANISHED", "NOT_REACHED", "TARGET_NOT_STABLE", "TARGET_NOT_VISIBLE", "STATE_NOT_REBUILT", "AI_ACTION_SKIPPED", "SAME_SHAPE_NO_CHANGE"] },
              "shape": { "type": "null" }
            }
          }
        },
        {
          "if": { "type": "object", "properties": { "result": { "const": "API_CREATE" } }, "required": ["result"] },
          "then": { "type": "object", "properties": { "reason": { "type": "null" }, "shape": { "type": "object" } } }
        },
        {
          "if": { "type": "object", "properties": { "result": { "const": "API_UPDATE" } }, "required": ["result"] },
          "then": { "type": "object", "properties": { "reason": { "type": "null" }, "shape": { "type": "object" } } }
        },
        {
          "if": { "type": "object", "properties": { "result": { "const": "NO_REQUEST" } }, "required": ["result"] },
          "then": { "type": "object", "properties": { "reason": { "type": "null" }, "shape": { "type": "null" } } }
        },
        {
          "if": { "type": "object", "properties": { "shape": { "type": "null" } }, "required": ["shape"] },
          "then": { "type": "object", "properties": { "shapeDigest": { "type": "null" } } },
          "else": { "type": "object", "properties": { "shapeDigest": { "type": "string" } } }
        }
      ]
    },
    "apiRequestShape": {
      "description": "T37c: the shape of the blocked request of the probe (src/core/api-request-shape.ts; T37b). Names only; a value-like, too long or marker-carrying name is [REDACTED].",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "resourceType",
        "origin",
        "pathShape",
        "queryNames",
        "omittedQueryNameCount",
        "filters",
        "headerNames",
        "omittedHeaderNameCount",
        "contentType",
        "prefer",
        "body"
      ],
      "properties": {
        "method": { "type": "string", "pattern": "^(?:[A-Z]+|\\[REDACTED\\])$", "maxLength": 32 },
        "resourceType": { "type": "string", "pattern": "^[a-z]+$" },
        "origin": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "index"],
              "properties": { "kind": { "const": "APPROVED_API" }, "index": { "$ref": "#/$defs/count" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "index"],
              "properties": { "kind": { "const": "APPROVED_TEST" }, "index": { "$ref": "#/$defs/count" } }
            },
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "ALLOWED" } } },
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "OTHER" } } }
          ]
        },
        "pathShape": { "type": "string", "minLength": 1 },
        "queryNames": { "type": "array", "items": { "type": "string" } },
        "omittedQueryNameCount": { "$ref": "#/$defs/count" },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "operator", "valueMatchesPagePath"],
            "properties": {
              "name": { "type": "string" },
              "operator": { "enum": ["eq", "OTHER"] },
              "valueMatchesPagePath": { "type": "boolean" },
              "valueIsRecordIdLike": { "description": "Optional (LU-2; list row update design 5.2): whether the operator is of the closed list and the value is a record number (digits or a UUID). Never the value. Absent in the shapes written before LU-2.", "type": "boolean" }
            }
          }
        },
        "headerNames": { "type": "array", "items": { "type": "string" } },
        "omittedHeaderNameCount": { "$ref": "#/$defs/count" },
        "contentType": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "prefer": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "return=representation",
              "return=minimal",
              "return=headers-only",
              "resolution=merge-duplicates",
              "resolution=ignore-duplicates",
              "return=other",
              "resolution=other",
              "other"
            ]
          }
        },
        "body": { "$ref": "#/$defs/apiRequestBody" }
      }
    },
    "apiRequestBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "keys", "omittedKeyCount", "markerKeys", "stateKeyPresent"],
      "properties": {
        "kind": { "enum": ["NONE", "UNREADABLE", "NOT_JSON", "OBJECT", "ARRAY", "SCALAR"] },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "enum": ["string", "number", "boolean", "null", "object", "array"] },
              "elements": {
                "description": "ARR-1 (DEF-226): only for a key whose value is an array. The set of the JSON types of the elements, the count, whether an element is an object or an array, and whether a text element is longer than the limit. Never a value.",
                "type": "object",
                "additionalProperties": false,
                "required": ["types", "count", "nested", "textOverLimit"],
                "properties": {
                  "types": {
                    "type": "array",
                    "maxItems": 6,
                    "uniqueItems": true,
                    "items": { "enum": ["string", "number", "boolean", "null", "object", "array"] }
                  },
                  "count": { "$ref": "#/$defs/count" },
                  "nested": { "type": "boolean" },
                  "textOverLimit": { "type": "boolean" },
                  "positions": {
                    "description": "ARR-3 (DEF-234): only for an array with a marker in its elements and 2 or more elements (no upper limit since L13 fix round 1; ARR-5: 1 or more for an array with an object element). For each element in order: the marker numbers in it, whether it is an empty value (an empty text or null), and its JSON type. Never a value.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["markers", "empty", "type"],
                      "properties": {
                        "markers": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
                        "empty": { "type": "boolean" },
                        "type": { "enum": ["string", "number", "boolean", "null", "object", "array"] },
                        "keys": {
                          "description": "ARR-5 (DEF-234): only for an object element (any number of inner keys since L13 fix round 1; the records before it had none for a row over 16 inner keys). For each inner key in name order: the name (hidden like a top-level key), the marker numbers in its value, whether it is an empty value, its JSON type, and whether a text is longer than the limit. Never a value.",
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["name", "markers", "empty", "type"],
                            "properties": {
                              "name": { "type": "string" },
                              "markers": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
                              "empty": { "type": "boolean" },
                              "type": { "enum": ["string", "number", "boolean", "null", "object", "array"] },
                              "textOverLimit": { "const": true }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "omittedKeyCount": { "$ref": "#/$defs/count" },
        "markerKeys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "markers"],
            "properties": {
              "key": { "type": "string" },
              "markers": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
              "inArray": {
                "description": "ARR-1 (DEF-226): the markers were found in the elements of an array value (only true; absent otherwise).",
                "const": true
              }
            }
          }
        },
        "stateKeyPresent": {
          "description": "T37R-fix-A (I-3): whether any top-level key is a soft-delete state key, judged on the names before hiding and truncation. Only the truth value; never the name.",
          "type": "boolean"
        },
        "duplicateKeyPresent": {
          "description": "ARR-5 fix round 1 (SREV-ARR2 M2): only when an object of the body (the top level or in a list) has the same key twice in the text. Never the name.",
          "const": true
        }
      }
    }
  }
}
