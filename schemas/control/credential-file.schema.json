{
  "$id": "urn:beaksight:schema:control:credential-file:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "profileId",
    "loginOrigin",
    "credentialRevision",
    "createdAt",
    "updatedAt",
    "lastChangeKind",
    "protection",
    "username",
    "password"
  ],
  "properties": {
    "format": { "const": "beaksight-credential/1" },
    "profileId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "loginOrigin": { "type": "string", "minLength": 1 },
    "credentialRevision": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "pattern": "^[0-9]{14}$" },
    "updatedAt": { "type": "string", "pattern": "^[0-9]{14}$" },
    "lastChangeKind": { "enum": ["CREATED", "USERNAME_CHANGED", "PASSWORD_CHANGED", "BOTH_CHANGED"] },
    "protection": { "const": "DPAPI_CURRENT_USER" },
    "username": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
    "password": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
  }
}
