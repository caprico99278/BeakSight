{
  "$id": "urn:beaksight:schema:control:data-rule:2",
  "description": "One revision of the input rules of a write scenario, version 2 (Task 29 design 4.1; the fewer manual steps design 3A.3, FM2c): the rule of each field to send (semantic kind, generation method, range, fixed values, the origin mark, the window from the base date and the digit count), the relations between fields and the fields that make a record unique. Version 2 adds the origin mark (HUMAN when absent; INFERRED is a rule inferred by the templates or the generic rules and saved as it is, without fixed values) on the field rules, the relations and the unique key fields, the window from the base date in days (dates and date-times only; not together with a range), the digit count of a DIGIT_CODE rule, the semantic kind DIGIT_CODE, and templateDefaultsSaved (true when the relations and the unique key fields of the templates were saved; the judgement then uses only the saved ones). The value lists and limits are owned by src/control/data-rules/rule-contracts.ts; the digest is computed by src/control/data-rules/rule-digest.ts. Version 1 documents are not read (they were dropped in LG-3). Fixed values are kept in plain text (Task 29 design 10.4). No property holds a generated value, a token or a credential.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ruleSetId", "scenarioId", "revision", "fieldRules", "relations", "uniqueKeyFieldNames", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "beaksight-data-rule/2" },
    "ruleSetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "scenarioId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "fieldRules": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/fieldRule" } },
    "relations": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/relation" } },
    "uniqueKeyFieldNames": { "type": "array", "uniqueItems": true, "maxItems": 200, "items": { "$ref": "#/$defs/fieldName" } },
    "uniqueKeyOrigin": { "$ref": "#/$defs/origin" },
    "templateDefaultsSaved": { "type": "boolean" },
    "createdAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "fieldName": { "type": "string", "minLength": 1, "maxLength": 256 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{14}$" },
    "origin": { "enum": ["HUMAN", "INFERRED"] },
    "rangeValue": { "type": "string", "minLength": 1, "maxLength": 512 },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "step"],
      "properties": {
        "min": { "anyOf": [{ "$ref": "#/$defs/rangeValue" }, { "type": "null" }] },
        "max": { "anyOf": [{ "$ref": "#/$defs/rangeValue" }, { "type": "null" }] },
        "step": { "anyOf": [{ "$ref": "#/$defs/rangeValue" }, { "type": "null" }] }
      }
    },
    "windowDays": { "type": "integer", "minimum": 0, "maximum": 3650 },
    "baseDateWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromDays", "toDays"],
      "properties": {
        "fromDays": { "$ref": "#/$defs/windowDays" },
        "toDays": { "$ref": "#/$defs/windowDays" }
      }
    },
    "digitCount": { "type": "integer", "minimum": 1, "maximum": 256 },
    "fieldRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldName", "semanticKind", "method", "range", "fixedValues"],
      "properties": {
        "fieldName": { "$ref": "#/$defs/fieldName" },
        "semanticKind": {
          "enum": [
            "GENERIC_NUMBER",
            "GENERIC_DATETIME",
            "GENERIC_CHOICE",
            "GENERIC_COLOR",
            "FAMILY_NAME",
            "GIVEN_NAME",
            "FULL_NAME",
            "FAMILY_NAME_KANA",
            "GIVEN_NAME_KANA",
            "FULL_NAME_KANA",
            "EMAIL",
            "PHONE",
            "NOTE",
            "PRODUCT_NAME",
            "UNIT_PRICE",
            "QUANTITY",
            "TOTAL_PRICE",
            "DATE",
            "START_TIME",
            "END_TIME",
            "PARTY_SIZE",
            "FIXED_LIST",
            "OUT_OF_TEMPLATE",
            "DIGIT_CODE"
          ]
        },
        "method": { "enum": ["FROM_TYPE", "FROM_TEMPLATE", "FROM_FIXED_LIST"] },
        "range": { "anyOf": [{ "$ref": "#/$defs/range" }, { "type": "null" }] },
        "fixedValues": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "origin": { "$ref": "#/$defs/origin" },
        "baseDateWindow": { "anyOf": [{ "$ref": "#/$defs/baseDateWindow" }, { "type": "null" }] },
        "digitCount": { "anyOf": [{ "$ref": "#/$defs/digitCount" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "method": { "const": "FROM_FIXED_LIST" } }, "required": ["method"] },
          "then": { "properties": { "fixedValues": { "type": "array", "minItems": 1 } } },
          "else": { "properties": { "fixedValues": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": { "type": "object", "properties": { "origin": { "const": "INFERRED" } }, "required": ["origin"] },
          "then": { "properties": { "method": { "enum": ["FROM_TYPE", "FROM_TEMPLATE"] } } }
        }
      ]
    },
    "relation": {
      "oneOf": [
        { "$ref": "#/$defs/endAfterStart" },
        { "$ref": "#/$defs/totalEqualsUnitPriceTimesQuantity" },
        { "$ref": "#/$defs/kanaMatchesName" }
      ]
    },
    "endAfterStart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "startFieldName", "endFieldName"],
      "properties": {
        "kind": { "const": "END_AFTER_START" },
        "startFieldName": { "$ref": "#/$defs/fieldName" },
        "endFieldName": { "$ref": "#/$defs/fieldName" },
        "origin": { "$ref": "#/$defs/origin" }
      }
    },
    "totalEqualsUnitPriceTimesQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "unitPriceFieldName", "quantityFieldName", "totalFieldName"],
      "properties": {
        "kind": { "const": "TOTAL_EQUALS_UNIT_PRICE_TIMES_QUANTITY" },
        "unitPriceFieldName": { "$ref": "#/$defs/fieldName" },
        "quantityFieldName": { "$ref": "#/$defs/fieldName" },
        "totalFieldName": { "$ref": "#/$defs/fieldName" },
        "origin": { "$ref": "#/$defs/origin" }
      }
    },
    "kanaMatchesName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nameFieldName", "kanaFieldName"],
      "properties": {
        "kind": { "const": "KANA_MATCHES_NAME" },
        "nameFieldName": { "$ref": "#/$defs/fieldName" },
        "kanaFieldName": { "$ref": "#/$defs/fieldName" },
        "origin": { "$ref": "#/$defs/origin" }
      }
    }
  }
}
