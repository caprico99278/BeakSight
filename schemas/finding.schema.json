{
  "$id": "urn:beaksight:schema:finding:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "findingId",
    "fingerprint",
    "ruleId",
    "ruleVersion",
    "category",
    "severity",
    "pageId",
    "pageUrl",
    "viewport",
    "message",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": { "const": "finding-schema/1.0" },
    "findingId": { "type": "string", "pattern": "^FIND-[0-9]{6,}$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ruleId": { "type": "string", "minLength": 1 },
    "ruleVersion": { "type": "integer", "minimum": 1 },
    "category": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["ERROR", "WARN", "INFO", "SAFETY"] },
    "pageId": { "type": ["string", "null"] },
    "pageUrl": { "type": ["string", "null"] },
    "viewport": { "type": ["string", "null"] },
    "message": { "type": "string", "minLength": 1 },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EV-[A-Z0-9_]+-[0-9]{6,}$" }
    }
  }
}
